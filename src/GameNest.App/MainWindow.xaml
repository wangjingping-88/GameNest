<Window
    x:Class="GameNest.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:GameNest.App.Views"
    xmlns:viewModels="using:GameNest.App.ViewModels"
    mc:Ignorable="d">
    <Grid
        x:Name="ContentRoot"
        MinWidth="1000"
        MinHeight="680"
        Background="{ThemeResource GameNestCanvasBrush}"
        RequestedTheme="{Binding CurrentTheme, Converter={StaticResource ThemePreferenceToElementThemeConverter}}">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text" />
                <Setter Property="Foreground" Value="{ThemeResource GameNestPrimaryTextBrush}" />
            </Style>
            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="32" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource GameNestSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GameNestBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource GameNestCardCornerRadius}" />
            </Style>
            <Style x:Key="QuietButtonStyle" TargetType="Button">
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="Background" Value="{ThemeResource GameNestSecondarySurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GameNestBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource GameNestButtonCornerRadius}" />
                <Setter Property="Foreground" Value="{ThemeResource GameNestPrimaryTextBrush}" />
            </Style>
            <Style x:Key="NavigationItemStyle" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="50" />
                <Setter Property="Margin" Value="12,3" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
            </Style>
            <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="40" />
                <Setter Property="Padding" Value="40,0,16,0" />
                <Setter Property="Background" Value="{ThemeResource GameNestSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource GameNestSearchBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="20" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource GameNestPrimaryTextBrush}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="SearchOutline"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame
                                                        KeyTime="0"
                                                        Value="{ThemeResource GameNestAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Focused">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames
                                                    Storyboard.TargetName="SearchOutline"
                                                    Storyboard.TargetProperty="BorderBrush">
                                                    <DiscreteObjectKeyFrame
                                                        KeyTime="0"
                                                        Value="{ThemeResource GameNestAccentBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SearchOutline"
                                                    Storyboard.TargetProperty="Opacity"
                                                    Duration="0"
                                                    To="0.55" />
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>

                                <Border
                                    x:Name="SearchOutline"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    Control.IsTemplateFocusTarget="True"
                                    CornerRadius="{TemplateBinding CornerRadius}" />
                                <ScrollViewer
                                    x:Name="ContentElement"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AccessibilityView="Raw"
                                    HorizontalScrollBarVisibility="Hidden"
                                    HorizontalScrollMode="Auto"
                                    IsTabStop="False"
                                    VerticalScrollBarVisibility="Hidden"
                                    VerticalScrollMode="Disabled"
                                    ZoomMode="Disabled" />
                                <TextBlock
                                    x:Name="PlaceholderTextContentPresenter"
                                    Padding="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{ThemeResource TextControlPlaceholderForeground}"
                                    IsHitTestVisible="False"
                                    Text="{TemplateBinding PlaceholderText}"
                                    TextAlignment="{TemplateBinding TextAlignment}"
                                    TextWrapping="NoWrap" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <DataTemplate x:Key="GameCardTemplate" x:DataType="viewModels:GameCardViewModel">
                <Border
                    Width="202"
                    Height="304"
                    Background="{ThemeResource GameNestSurfaceBrush}"
                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    RightTapped="GameCard_RightTapped">
                    <Grid RowDefinitions="214,*">
                        <Border
                            Margin="8,8,8,0"
                            Background="{ThemeResource GameNestHeroBrush}"
                            CornerRadius="8,8,4,4">
                            <Grid>
                                <FontIcon
                                    FontSize="54"
                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                    Glyph="&#xE7FC;"
                                    Opacity="0.48"
                                    Visibility="{Binding HasNoCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Image
                                    AutomationProperties.Name="{x:Bind CoverDescription, Mode=OneWay}"
                                    Source="{Binding CoverPath, Converter={StaticResource LocalPathToBitmapImageConverter}, ConverterParameter=404}"
                                    Stretch="UniformToFill"
                                    Visibility="{Binding HasCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Image
                                    Width="72"
                                    Height="72"
                                    Source="{Binding IconPath, Converter={StaticResource LocalPathToBitmapImageConverter}, ConverterParameter=144}"
                                    Stretch="Uniform"
                                    Visibility="{Binding HasNoCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border
                                    Margin="10"
                                    Padding="8,5"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource GameNestSurfaceBrush}"
                                    CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <FontIcon
                                            FontSize="11"
                                            Foreground="{ThemeResource GameNestAccentBrush}"
                                            Glyph="{x:Bind RuntimeStatusGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            FontSize="11"
                                            Text="{x:Bind RuntimeStatusText, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                                <Button
                                    Margin="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    AutomationProperties.Name="{x:Bind FavoriteLabel, Mode=OneWay}"
                                    Command="{x:Bind ToggleFavoriteCommand}"
                                    Style="{StaticResource IconButtonStyle}">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource GameNestAccentBrush}"
                                        Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                                </Button>
                            </Grid>
                        </Border>
                        <Grid
                            Grid.Row="1"
                            Padding="13,10"
                            ColumnDefinitions="*,Auto">
                            <StackPanel VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    MaxLines="1"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{x:Bind CardSubtitleText, Mode=OneWay}" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                MinWidth="44"
                                AutomationProperties.Name="启动游戏"
                                Command="{x:Bind LaunchCommand}"
                                Style="{StaticResource IconButtonStyle}">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                    Glyph="&#xE768;" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ScanCandidateTemplate" x:DataType="viewModels:ScanCandidateViewModel">
                <Border
                    Margin="0,3"
                    Padding="12"
                    Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Grid ColumnDefinitions="Auto,12,40,12,*,12,Auto">
                        <CheckBox
                            VerticalAlignment="Center"
                            AutomationProperties.Name="选择扫描候选"
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                        <Border
                            Grid.Column="2"
                            Width="40"
                            Height="40"
                            VerticalAlignment="Center"
                            Background="{ThemeResource GameNestAccentSoftBrush}"
                            CornerRadius="20">
                            <FontIcon
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="18"
                                Foreground="{ThemeResource GameNestAccentBrush}"
                                Glyph="{x:Bind SourceGlyph}" />
                        </Border>
                        <StackPanel Grid.Column="4" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    MaxWidth="360"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Title}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                    Text="{x:Bind ConfidenceText}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{x:Bind ScoreText}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{x:Bind PrimaryText}" />
                            </StackPanel>
                            <TextBlock
                                MaxLines="1"
                                FontSize="12"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="{x:Bind ExecutablePath}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                MaxLines="2"
                                FontSize="12"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="{x:Bind EvidenceText}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="6" VerticalAlignment="Center" Spacing="7">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="12"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="{x:Bind SourceText}" />
                            <Button
                                Padding="10,5"
                                AutomationProperties.Name="排除候选所在目录"
                                Command="{Binding DataContext.Scan.ExcludeDirectoryCommand, ElementName=ContentRoot}"
                                CommandParameter="{Binding}"
                                Content="排除目录"
                                Style="{StaticResource QuietButtonStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Background="{ThemeResource GameNestCanvasBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="252" />
                <ColumnDefinition Width="7*" MaxWidth="760" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="138" />
            </Grid.ColumnDefinitions>

            <Grid
                Grid.Column="0"
                Padding="18,4"
                Background="{ThemeResource GameNestNavigationBrush}">
                <Border
                    Width="216"
                    Height="44"
                    Padding="4,2"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="GameNest"
                    Background="{ThemeResource GameNestLogoBackgroundBrush}"
                    BorderBrush="{ThemeResource GameNestLogoBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9">
                    <Image
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Source="{ThemeResource GameNestHorizontalLogoSource}"
                        Stretch="Uniform" />
                </Border>
            </Grid>

            <Grid
                Grid.Column="1"
                Height="40"
                Margin="28,6,12,6">
                <TextBox
                    AutomationProperties.HelpText="按游戏名称筛选本地游戏库"
                    AutomationProperties.Name="搜索游戏"
                    PlaceholderText="搜索游戏"
                    Style="{StaticResource SearchTextBoxStyle}"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <FontIcon
                    Margin="14,2,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                    Glyph="&#xE721;"
                    IsHitTestVisible="False" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Background="{ThemeResource GameNestNavigationBrush}"
            BorderBrush="{ThemeResource GameNestBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView
                    Margin="0,16,0,0"
                    AutomationProperties.Name="主导航"
                    IsItemClickEnabled="False"
                    ItemContainerStyle="{StaticResource NavigationItemStyle}"
                    ItemsSource="{Binding NavigationItems}"
                    SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:NavigationItemViewModel">
                            <Grid ColumnDefinitions="30,*">
                                <FontIcon
                                    Width="22"
                                    HorizontalAlignment="Left"
                                    FontSize="18"
                                    Glyph="{x:Bind Glyph}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="15"
                                    Text="{x:Bind Label}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel
                    Grid.Row="1"
                    Margin="22,12,22,22"
                    Spacing="10">
                    <Border
                        Height="1"
                        Margin="0,0,0,8"
                        Background="{ThemeResource GameNestBorderBrush}" />
                    <Grid ColumnDefinitions="22,*">
                        <FontIcon
                            VerticalAlignment="Top"
                            FontSize="14"
                            Foreground="{ThemeResource GameNestAccentBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock
                            Grid.Column="1"
                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                            FontSize="12"
                            Text="本地优先 · 数据留在设备上"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <InfoBar
                Grid.Row="0"
                Margin="36,10,40,0"
                AutomationProperties.Name="应用更新提示"
                IsClosable="True"
                IsOpen="{Binding IsUpdateNotificationOpen, Mode=TwoWay}"
                Message="{Binding UpdateStatus}"
                Severity="Informational"
                Title="发现 GameNest 新版本">
                <InfoBar.ActionButton>
                    <Button
                        AutomationProperties.Name="处理可用应用更新"
                        Command="{Binding InstallOrOpenUpdateCommand}"
                        Content="{Binding UpdateActionLabel}"
                        IsEnabled="{Binding IsUpdateActionEnabled}"
                        Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <ScrollViewer
                x:Name="MainScrollViewer"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Disabled"
                VerticalContentAlignment="Stretch"
                VerticalScrollBarVisibility="Disabled">
            <Grid
                MinHeight="{Binding ActualHeight, ElementName=MainScrollViewer}"
                Padding="36,24,40,28">
                <Grid
                    x:Name="HomePage"
                    Visibility="{Binding IsHomePage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <Image
                        x:Name="HomeCoverBackground"
                        Grid.RowSpan="5"
                        AutomationProperties.Name="首页最近游玩游戏封面背景"
                        Opacity="0.82"
                        Source="{Binding HeroGame.CoverPath, Converter={StaticResource LocalPathToBitmapImageConverter}, ConverterParameter=1920}"
                        Stretch="UniformToFill"
                        Visibility="{Binding HeroGame.HasCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border
                        Background="#B8141A22"
                        BorderThickness="0"
                        CornerRadius="0">
                        <Grid ColumnDefinitions="3*,2*">
                            <StackPanel
                                Margin="40,24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Spacing="14"
                                Visibility="{Binding HasNoHeroGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="110"
                                    Text="YOUR LOCAL GAME HOME" />
                                <TextBlock
                                    MaxWidth="560"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="36"
                                    FontWeight="SemiBold"
                                    Text="让每一次启动，&#xA;都从熟悉的地方开始"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="540"
                                    FontSize="15"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="GameNest 已准备好安全、清晰的本地空间。先选择喜欢的外观，游戏始终由你主动添加。"
                                    TextWrapping="Wrap" />
                                <Button
                                    MinWidth="128"
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="打开外观设置"
                                    Command="{Binding OpenSettingsCommand}"
                                    Content="调整外观"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>

                            <StackPanel
                                Margin="40,24"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Spacing="12"
                                Visibility="{Binding HasHeroGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock
                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    CharacterSpacing="110"
                                    Text="CONTINUE LOCALLY" />
                                <TextBlock
                                    MaxWidth="560"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="36"
                                    FontWeight="SemiBold"
                                    MaxLines="2"
                                    Text="{Binding HeroGame.Title}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    MaxWidth="540"
                                    MaxLines="2"
                                    FontSize="15"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{Binding HeroGame.DescriptionText}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button
                                        MinWidth="128"
                                        AutomationProperties.Name="启动最近使用的游戏"
                                        Command="{Binding HeroGame.LaunchCommand}"
                                        Content="继续游玩"
                                        Style="{StaticResource AccentButtonStyle}" />
                                    <Button
                                        AutomationProperties.Name="打开游戏库"
                                        Command="{Binding OpenHeroDetailsCommand}"
                                        Content="查看详情"
                                        Style="{StaticResource QuietButtonStyle}" />
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Column="1" IsHitTestVisible="False">
                                <Image
                                    AutomationProperties.Name="最近使用游戏的封面"
                                    Opacity="0.32"
                                    Source="{Binding HeroGame.CoverPath, Converter={StaticResource LocalPathToBitmapImageConverter}, ConverterParameter=720}"
                                    Stretch="UniformToFill"
                                    Visibility="{Binding HeroGame.HasCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <Border
                                    Width="176"
                                    Height="176"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{ThemeResource GameNestAccentSoftBrush}"
                                    CornerRadius="88"
                                    Opacity="0.92">
                                    <FontIcon
                                        FontSize="72"
                                        Foreground="{ThemeResource GameNestAccentBrush}"
                                        Glyph="&#xE7FC;"
                                        Opacity="0.78" />
                                </Border>
                                <Border
                                    Margin="0,0,26,30"
                                    Padding="12,7"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="{ThemeResource GameNestSurfaceBrush}"
                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon
                                            FontSize="13"
                                            Foreground="{ThemeResource GameNestAccentBrush}"
                                            Glyph="&#xE72E;" />
                                        <TextBlock FontSize="12" Text="本地优先" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Visibility="Collapsed">
                        <TextBlock
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Variable Display"
                            FontSize="22"
                            FontWeight="SemiBold"
                            Text="游戏库" />
                        <Border
                            Grid.Column="1"
                            Padding="11,6"
                            Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                            BorderBrush="{ThemeResource GameNestBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14">
                            <TextBlock
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                FontSize="12"
                                Text="{Binding GameCountText}" />
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="4"
                        Padding="28"
                        AutomationProperties.Name="正在加载本地游戏库"
                        Style="{StaticResource SurfaceCardStyle}"
                        Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Spacing="16">
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="正在读取本地游戏与封面…" />
                            <Grid ColumnDefinitions="*,14,*,14,*">
                                <Border Grid.Column="0" Height="124" Background="{ThemeResource GameNestSecondarySurfaceBrush}" CornerRadius="9" />
                                <Border Grid.Column="2" Height="124" Background="{ThemeResource GameNestSecondarySurfaceBrush}" CornerRadius="9" Opacity="0.78" />
                                <Border Grid.Column="4" Height="124" Background="{ThemeResource GameNestSecondarySurfaceBrush}" CornerRadius="9" Opacity="0.58" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="4"
                        MinHeight="220"
                        Visibility="Collapsed"
                        Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel
                            Margin="24,16"
                            MaxWidth="820"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Spacing="8">
                            <Border
                                Width="48"
                                Height="48"
                                HorizontalAlignment="Center"
                                Background="{ThemeResource GameNestAccentSoftBrush}"
                                CornerRadius="24">
                                <FontIcon
                                    FontSize="22"
                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                    Glyph="&#xE7FC;" />
                            </Border>
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="{Binding EmptyTitle}" />
                            <TextBlock
                                MaxWidth="520"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="{Binding EmptyDescription}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="添加第一款游戏"
                                Click="AddGame_Click"
                                Content="添加游戏"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Grid Margin="0,8,0,0" ColumnDefinitions="*,12,*,12,*">
                                <Border
                                    Grid.Column="0"
                                    Padding="10"
                                    Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                                        <FontIcon
                                            FontSize="17"
                                            Foreground="{ThemeResource GameNestAccentBrush}"
                                            Glyph="&#xE706;" />
                                        <TextBlock
                                            FontSize="12"
                                            Text="主题已可选择"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="2"
                                    Padding="10"
                                    Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                                        <FontIcon
                                            FontSize="17"
                                            Foreground="{ThemeResource GameNestAccentBrush}"
                                            Glyph="&#xE72E;" />
                                        <TextBlock
                                            FontSize="12"
                                            Text="数据仅保存在本机"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Grid.Column="4"
                                    Padding="10"
                                    Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                    <StackPanel HorizontalAlignment="Center" Spacing="7">
                                        <FontIcon
                                            FontSize="17"
                                            Foreground="{ThemeResource GameNestAccentBrush}"
                                            Glyph="&#xE896;" />
                                        <TextBlock
                                            FontSize="12"
                                            Text="不会主动扫描磁盘"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <GridView
                        Grid.Row="4"
                        Padding="10"
                        AutomationProperties.Name="首页游戏列表"
                        IsItemClickEnabled="True"
                        ItemTemplate="{StaticResource GameCardTemplate}"
                        ItemsSource="{Binding Games}"
                        SelectionMode="None"
                        Visibility="Collapsed">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid
                                    HorizontalAlignment="Left"
                                    MaximumRowsOrColumns="1"
                                    Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>

                <Grid
                    x:Name="GameCollectionPage"
                    Visibility="{Binding IsGameCollectionPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="20" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnDefinitions="*,Auto,12,Auto,12,Auto,12,Auto">
                        <StackPanel Spacing="7">
                            <TextBlock
                                Style="{StaticResource PageTitleStyle}"
                                Text="{Binding PageTitle}" />
                            <TextBlock
                                MaxWidth="760"
                                HorizontalAlignment="Left"
                                FontSize="15"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="{Binding PageDescription}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="12,7"
                            VerticalAlignment="Center"
                            Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                            BorderBrush="{ThemeResource GameNestBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="{Binding DisplayedGameCountText}" />
                        </Border>
                        <Button
                            Grid.Column="5"
                            MinWidth="124"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="获取缺失游戏封面"
                            Click="FetchAllCovers_Click"
                            Content="获取全部封面"
                            IsEnabled="{Binding IsLibraryReady}"
                            Style="{StaticResource QuietButtonStyle}"
                            Visibility="{Binding IsLibraryPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Button
                            Grid.Column="7"
                            MinWidth="124"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="游戏库操作"
                            Click="AddGame_Click"
                            Content="{Binding CollectionActionText}"
                            Style="{StaticResource AccentButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Border
                            Width="960"
                            Height="300"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="正在加载本地游戏库"
                            Style="{StaticResource SurfaceCardStyle}"
                            Visibility="{Binding IsLibraryLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Margin="44" VerticalAlignment="Center" Spacing="16">
                                <TextBlock
                                    FontSize="14"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="正在准备游戏卡片…" />
                                <Grid ColumnDefinitions="*,14,*,14,*">
                                    <Border Grid.Column="0" Height="150" Background="{ThemeResource GameNestSecondarySurfaceBrush}" CornerRadius="9" />
                                    <Border Grid.Column="2" Height="150" Background="{ThemeResource GameNestSecondarySurfaceBrush}" CornerRadius="9" Opacity="0.78" />
                                    <Border Grid.Column="4" Height="150" Background="{ThemeResource GameNestSecondarySurfaceBrush}" CornerRadius="9" Opacity="0.58" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border
                            Width="720"
                            Padding="32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            AutomationProperties.LiveSetting="Assertive"
                            Style="{StaticResource SurfaceCardStyle}"
                            Visibility="{Binding HasLibraryError, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" Spacing="12">
                                <FontIcon
                                    FontSize="30"
                                    Foreground="{ThemeResource GameNestDangerBrush}"
                                    Glyph="&#xE783;" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="无法读取本地游戏库" />
                                <TextBlock
                                    MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{Binding LibraryErrorMessage}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    AutomationProperties.Name="重新加载本地游戏库"
                                    Command="{Binding RetryLibraryLoadCommand}"
                                    Content="重新加载"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Width="960"
                            Height="390"
                            Margin="0,0,0,32"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource SurfaceCardStyle}"
                            Visibility="{Binding HasNoDisplayedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel
                                Margin="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                                <Border
                                    Width="60"
                                    Height="60"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource GameNestAccentSoftBrush}"
                                    CornerRadius="30">
                                    <FontIcon
                                        FontSize="26"
                                        Foreground="{ThemeResource GameNestAccentBrush}"
                                        Glyph="{Binding EmptyGlyph}" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding EmptyTitle}" />
                                <TextBlock
                                    MaxWidth="560"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{Binding EmptyDescription}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Center"
                                    AutomationProperties.Name="前往游戏库"
                                    Click="AddGame_Click"
                                    Content="{Binding CollectionActionText}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </StackPanel>
                        </Border>

                        <Grid
                            ColumnDefinitions="*,20,356"
                            Visibility="{Binding HasDisplayedGames, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <GridView
                                x:Name="GameGrid"
                                Grid.Column="0"
                                Padding="2"
                                AutomationProperties.Name="游戏卡片列表"
                                IsItemClickEnabled="True"
                                ItemTemplate="{StaticResource GameCardTemplate}"
                                ItemsSource="{Binding DisplayedGames}"
                                SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                                SelectionChanged="GameGrid_SelectionChanged"
                                SelectionMode="Extended"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding IsNotRecentPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid
                                            HorizontalAlignment="Left"
                                            ItemHeight="316"
                                            ItemWidth="214"
                                            Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                            </GridView>

                            <ListView
                                Grid.Column="0"
                                Padding="2"
                                AutomationProperties.Name="按时间分组的最近游玩列表"
                                ItemsSource="{Binding RecentPlayGroups}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Visibility="{Binding IsRecentPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:RecentPlayGroupViewModel">
                                        <StackPanel Margin="0,0,0,22" Spacing="10">
                                            <TextBlock
                                                FontFamily="Segoe UI Variable Display"
                                                FontSize="18"
                                                FontWeight="SemiBold"
                                                Text="{x:Bind Title}" />
                                            <GridView
                                                Height="316"
                                                IsItemClickEnabled="True"
                                                ItemTemplate="{StaticResource GameCardTemplate}"
                                                ItemsSource="{x:Bind Games}"
                                                SelectedItem="{Binding DataContext.SelectedGame, ElementName=ContentRoot, Mode=TwoWay}"
                                                SelectionChanged="GameGrid_SelectionChanged"
                                                SelectionMode="Extended"
                                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <GridView.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid
                                                            HorizontalAlignment="Left"
                                                            ItemHeight="316"
                                                            ItemWidth="214"
                                                            MaximumRowsOrColumns="1"
                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </GridView.ItemsPanel>
                                            </GridView>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <Border
                                Grid.Column="2"
                                Padding="24"
                                Style="{StaticResource SurfaceCardStyle}"
                                Visibility="{Binding HasSelectedGame, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid RowDefinitions="Auto,18,Auto,18,*,18,Auto">
                                    <Grid ColumnDefinitions="92,14,*">
                                        <Border
                                            Width="92"
                                            Height="138"
                                            Background="{ThemeResource GameNestHeroBrush}"
                                            CornerRadius="12">
                                            <Grid>
                                                <FontIcon
                                                    FontSize="30"
                                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                                    Glyph="&#xE7FC;"
                                                    Opacity="0.45"
                                                    Visibility="{Binding SelectedGame.HasNoCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Image
                                                    AutomationProperties.Name="{Binding SelectedGame.CoverDescription}"
                                                    Source="{Binding SelectedGame.CoverPath, Converter={StaticResource LocalPathToBitmapImageConverter}, ConverterParameter=276}"
                                                    Stretch="UniformToFill"
                                                    Visibility="{Binding SelectedGame.HasCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                <Image
                                                    Width="48"
                                                    Height="48"
                                                    Source="{Binding SelectedGame.IconPath, Converter={StaticResource LocalPathToBitmapImageConverter}, ConverterParameter=96}"
                                                    Stretch="Uniform"
                                                    Visibility="{Binding SelectedGame.HasNoCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="5">
                                            <TextBlock
                                                MaxLines="2"
                                                FontFamily="Segoe UI Variable Display"
                                                FontSize="21"
                                                FontWeight="SemiBold"
                                                Text="{Binding SelectedGame.Title}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GameNestAccentBrush}"
                                                    Glyph="{Binding SelectedGame.RuntimeStatusGlyph}" />
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                    Text="{Binding SelectedGame.RuntimeStatusText}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                Text="{Binding SelectedGame.MetadataSourceText}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock
                                        Grid.Row="2"
                                        Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                        Text="{Binding SelectedGame.DescriptionText}"
                                        TextWrapping="Wrap" />

                                    <StackPanel Grid.Row="4" Spacing="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                Text="主程序" />
                                            <TextBlock
                                                MaxLines="3"
                                                FontSize="13"
                                                Text="{Binding SelectedGame.ExecutablePath}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Spacing="4">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                Text="工作目录" />
                                            <TextBlock
                                                MaxLines="2"
                                                FontSize="13"
                                                Text="{Binding SelectedGame.WorkingDirectory}"
                                                TextTrimming="CharacterEllipsis"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                    Text="最近启动" />
                                                <TextBlock FontSize="13" Text="{Binding SelectedGame.LastPlayedText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                    Text="来源" />
                                                <TextBlock FontSize="13" Text="{Binding SelectedGame.SourceText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,*">
                                            <StackPanel Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                    Text="本次会话" />
                                                <TextBlock FontSize="13" Text="{Binding SelectedGame.SessionDurationText}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock
                                                    FontSize="12"
                                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                    Text="累计时长" />
                                                <TextBlock FontSize="13" Text="{Binding SelectedGame.TotalPlayTimeText}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border
                                            Padding="9,6"
                                            Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                                            BorderBrush="{ThemeResource GameNestBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Visibility="{Binding SelectedGame.IsSessionActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                                Text="{Binding SelectedGame.ProcessConfidenceText}"
                                                TextWrapping="Wrap" />
                                        </Border>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="收藏当前游戏"
                                            Command="{Binding ToggleFavoriteCommand}"
                                            CommandParameter="{Binding SelectedGame}"
                                            Content="{Binding SelectedGame.FavoriteLabel}"
                                            Style="{StaticResource QuietButtonStyle}" />
                                        <StackPanel Spacing="8">
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                AutomationProperties.HelpText="选择 PNG、JPG、BMP 或 WebP 图片；GameNest 会生成本地缩略图"
                                                AutomationProperties.Name="更换当前游戏封面"
                                                Click="ChangeCover_Click"
                                                Content="选择封面"
                                                Style="{StaticResource QuietButtonStyle}" />
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                AutomationProperties.Name="移除当前游戏封面"
                                                Click="RemoveCover_Click"
                                                Content="移除封面"
                                                Style="{StaticResource QuietButtonStyle}"
                                                Visibility="{Binding SelectedGame.HasCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                        <Button
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="在线匹配游戏封面"
                                            Click="SearchOnlineCover_Click"
                                            Content="在线匹配封面"
                                            Style="{StaticResource QuietButtonStyle}" />
                                    </StackPanel>

                                    <Grid Grid.Row="6" RowDefinitions="Auto,8,Auto,8,Auto,8,Auto">
                                        <Button
                                            Grid.Column="0"
                                            MinWidth="124"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="启动当前游戏"
                                            Command="{Binding LaunchGameCommand}"
                                            CommandParameter="{Binding SelectedGame}"
                                            Content="{Binding SelectedGame.LaunchButtonText}"
                                            Style="{StaticResource AccentButtonStyle}" />
                                        <Button
                                            Grid.Row="2"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="调整当前游戏覆盖层"
                                            Click="GameOverlaySettings_Click"
                                            Content="覆盖层"
                                            Style="{StaticResource QuietButtonStyle}" />
                                        <Button
                                            Grid.Row="4"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="编辑当前游戏"
                                            Click="EditGame_Click"
                                            Content="编辑"
                                            Style="{StaticResource QuietButtonStyle}" />
                                        <Button
                                            Grid.Row="6"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Center"
                                            AutomationProperties.Name="从库中移除当前游戏"
                                            Click="RemoveGame_Click"
                                            Content="移除"
                                            Style="{StaticResource QuietButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <Border
                        Grid.Row="2"
                        Margin="14,0,14,14"
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{ThemeResource GameNestHeroBrush}"
                        BorderBrush="{ThemeResource GameNestBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Visibility="{Binding HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock
                            MaxWidth="760"
                            FontSize="12"
                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Grid
                    x:Name="ScanPage"
                    Visibility="{Binding IsScanPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="18" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="7">
                            <TextBlock Style="{StaticResource PageTitleStyle}" Text="扫描与导入" />
                            <TextBlock
                                FontSize="15"
                                Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                Text="管理扫描范围，查看可解释的候选并确认导入。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <Button
                                AutomationProperties.Name="添加扫描目录"
                                Click="AddScanRoot_Click"
                                Content="＋ 添加目录"
                                Style="{StaticResource QuietButtonStyle}" />
                            <Button
                                AutomationProperties.Name="开始快速扫描"
                                Command="{Binding Scan.StartQuickScanCommand}"
                                Content="快速扫描"
                                IsEnabled="{Binding Scan.CanStartScan}"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                AutomationProperties.Name="开始深度扫描"
                                Command="{Binding Scan.StartDeepScanCommand}"
                                Content="深度扫描"
                                IsEnabled="{Binding Scan.CanStartScan}"
                                Style="{StaticResource QuietButtonStyle}" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="360,18,*">
                        <Border Padding="20" Style="{StaticResource SurfaceCardStyle}">
                            <Grid RowDefinitions="Auto,14,*,14,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontFamily="Segoe UI Variable Display"
                                            FontSize="19"
                                            FontWeight="SemiBold"
                                            Text="扫描范围" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                            Text="保存卷标识与相对路径，盘符变化后自动重新绑定。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <FontIcon
                                        Grid.Column="1"
                                        FontSize="19"
                                        Foreground="{ThemeResource GameNestAccentBrush}"
                                        Glyph="&#xE896;" />
                                </Grid>

                                <Grid Grid.Row="2">
                                    <StackPanel
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Spacing="10"
                                        Visibility="{Binding Scan.HasNoRoots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <FontIcon FontSize="26" Foreground="{ThemeResource GameNestAccentBrush}" Glyph="&#xE8B7;" />
                                        <TextBlock FontWeight="SemiBold" Text="还没有扫描目录" />
                                        <TextBlock
                                            MaxWidth="260"
                                            FontSize="12"
                                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                            Text="选择游戏所在目录；GameNest 不会默认遍历系统盘。"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ListView
                                        AutomationProperties.Name="扫描根目录列表"
                                        ItemsSource="{Binding Scan.Roots}"
                                        SelectionMode="None"
                                        Visibility="{Binding Scan.HasRoots, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:ScanRootViewModel">
                                                <Border
                                                    Margin="0,3"
                                                    Padding="12"
                                                    Background="{ThemeResource GameNestSecondarySurfaceBrush}"
                                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">
                                                    <Grid RowDefinitions="Auto,6,Auto,8,Auto">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Path}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                                            <TextBlock FontSize="12" Foreground="{ThemeResource GameNestAccentBrush}" Text="{x:Bind StatusText}" />
                                                            <TextBlock FontSize="12" Foreground="{ThemeResource GameNestSecondaryTextBrush}" Text="{x:Bind LastScanText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="4" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                                                            <Button
                                                                Padding="8,4"
                                                                Command="{Binding DataContext.Scan.ToggleRootCommand, ElementName=ContentRoot}"
                                                                CommandParameter="{Binding}"
                                                                Content="{x:Bind ToggleLabel}"
                                                                Style="{StaticResource QuietButtonStyle}" />
                                                            <Button
                                                                Padding="8,4"
                                                                Command="{Binding DataContext.Scan.RemoveRootCommand, ElementName=ContentRoot}"
                                                                CommandParameter="{Binding}"
                                                                Content="移除"
                                                                Style="{StaticResource QuietButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>

                                <Border
                                    Grid.Row="4"
                                    Padding="14"
                                    Background="{ThemeResource GameNestHeroBrush}"
                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Scan.ProgressText}" TextWrapping="Wrap" />
                                        <TextBlock
                                            MaxLines="2"
                                            FontSize="12"
                                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                            Text="{Binding Scan.CurrentPath}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Command="{Binding Scan.PauseOrResumeCommand}" Content="{Binding Scan.PauseButtonText}" IsEnabled="{Binding Scan.IsScanning}" Style="{StaticResource QuietButtonStyle}" />
                                            <Button Command="{Binding Scan.CancelScanCommand}" Content="取消" IsEnabled="{Binding Scan.IsScanning}" Style="{StaticResource QuietButtonStyle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Padding="20" Style="{StaticResource SurfaceCardStyle}">
                            <Grid RowDefinitions="Auto,12,*,12,Auto,12,Auto">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="4">
                                        <TextBlock
                                            FontFamily="Segoe UI Variable Display"
                                            FontSize="19"
                                            FontWeight="SemiBold"
                                            Text="扫描结果确认" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                            Text="依据、分数与主程序选择都保留在本机；勾选后再导入。" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Command="{Binding Scan.UndoExclusionCommand}" Content="撤销最近排除" Style="{StaticResource QuietButtonStyle}" />
                                </Grid>

                                <Pivot Grid.Row="2">
                                    <PivotItem Header="确定是游戏">
                                        <Grid RowDefinitions="Auto,8,*">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource GameNestSecondaryTextBrush}" Text="{Binding Scan.HighCountText}" />
                                            <ListView Grid.Row="2" AutomationProperties.Name="高置信度候选" ItemTemplate="{StaticResource ScanCandidateTemplate}" ItemsSource="{Binding Scan.HighConfidenceCandidates}" SelectionMode="None" />
                                        </Grid>
                                    </PivotItem>
                                    <PivotItem Header="可能是游戏">
                                        <Grid RowDefinitions="Auto,8,*">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource GameNestSecondaryTextBrush}" Text="{Binding Scan.PossibleCountText}" />
                                            <ListView Grid.Row="2" AutomationProperties.Name="中置信度候选" ItemTemplate="{StaticResource ScanCandidateTemplate}" ItemsSource="{Binding Scan.PossibleCandidates}" SelectionMode="None" />
                                        </Grid>
                                    </PivotItem>
                                    <PivotItem Header="已忽略">
                                        <Grid RowDefinitions="Auto,8,*">
                                            <TextBlock FontSize="12" Foreground="{ThemeResource GameNestSecondaryTextBrush}" Text="{Binding Scan.IgnoredCountText}" />
                                            <ListView Grid.Row="2" AutomationProperties.Name="已忽略候选" ItemTemplate="{StaticResource ScanCandidateTemplate}" ItemsSource="{Binding Scan.IgnoredCandidates}" SelectionMode="None" />
                                        </Grid>
                                    </PivotItem>
                                </Pivot>

                                <Border
                                    Grid.Row="4"
                                    Padding="12,8"
                                    Background="{ThemeResource GameNestHeroBrush}"
                                    BorderBrush="{ThemeResource GameNestBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding Scan.HasStatusMessage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock FontSize="12" Foreground="{ThemeResource GameNestSecondaryTextBrush}" Text="{Binding Scan.StatusMessage}" TextWrapping="Wrap" />
                                </Border>

                                <Grid Grid.Row="6" ColumnDefinitions="*,Auto">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                        Text="同目录只默认勾选评分最高的主程序，备选入口仍会保留。" />
                                    <Button
                                        Grid.Column="1"
                                        MinWidth="138"
                                        Command="{Binding Scan.ConfirmSelectedCommand}"
                                        Content="确认并加入游戏库"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
                <views:SettingsPageView
                    x:Name="SettingsPage"
                    ExportDiagnosticsRequested="ExportDiagnostics_Click"
                    Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Grid
                    x:Name="GenericPage"
                    Visibility="{Binding IsGenericPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="26" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Spacing="7">
                        <TextBlock
                            Style="{StaticResource PageTitleStyle}"
                            Text="{Binding PageTitle}" />
                        <TextBlock
                            MaxWidth="760"
                            HorizontalAlignment="Left"
                            FontSize="15"
                            Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                            Text="{Binding PageDescription}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Grid.Row="2"
                        Width="960"
                        Height="390"
                        Margin="0,0,0,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Style="{StaticResource SurfaceCardStyle}">
                            <StackPanel
                                Margin="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                                <Border
                                    Width="60"
                                    Height="60"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource GameNestAccentSoftBrush}"
                                    CornerRadius="30">
                                    <FontIcon
                                        FontSize="26"
                                        Foreground="{ThemeResource GameNestAccentBrush}"
                                        Glyph="{Binding EmptyGlyph}" />
                                </Border>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe UI Variable Display"
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Text="{Binding EmptyTitle}" />
                                <TextBlock
                                    MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource GameNestSecondaryTextBrush}"
                                    Text="{Binding EmptyDescription}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
