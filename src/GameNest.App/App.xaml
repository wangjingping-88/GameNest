<Application
    x:Class="GameNest.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:GameNest.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/ThemeTokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:ThemePreferenceToElementThemeConverter
                x:Key="ThemePreferenceToElementThemeConverter" />
            <converters:BooleanToVisibilityConverter
                x:Key="BooleanToVisibilityConverter" />
            <converters:LocalPathToBitmapImageConverter
                x:Key="LocalPathToBitmapImageConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
